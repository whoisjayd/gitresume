# GitResume self-hosting configuration.
# Copy this file to .env and replace placeholders with real values.
# Never commit .env or provider secrets.

# Runtime
ENVIRONMENT=production
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1,api
SESSION_SECRET_KEY=change-me
REDIS_URL=redis://redis:6379/0

# GitHub OAuth and repository access
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=
CALLBACK_URL=http://localhost:5173/api/session/callback

# AI generation through LiteLLM
# Example models: gemini/gemini-1.5-flash, openai/gpt-4o-mini, anthropic/claude-3-5-haiku-20241022, groq/llama-3.3-70b-versatile
AI_MODEL=gemini/gemini-1.5-flash
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=90

# Set the key required by your selected AI_MODEL/provider.
LITELLM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Repository processing limits
MAX_REPO_SIZE_MB=100
MAX_REPO_FILES=200
RANKED_CONTEXT_FILE_LIMIT=20
RANKED_CONTEXT_CHARS_PER_FILE=8000
GENERATION_TTL_SECONDS=86400
GENERATION_EVENT_MAX_LEN=200
