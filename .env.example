GITHUB_TOKEN=your_github_token

# --- GitResume Core Configuration ---
GITRESUME_ARTIFACTS_DIR=./artifacts
GITRESUME_LOG_LEVEL=INFO

# --- AI Configuration (LiteLLM) ---
# Default model to use (format: provider/model)
AI_MODEL=gemini/gemini-2.0-flash-lite

# API Keys (LiteLLM standard environment variables)
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GROQ_API_KEY=your_groq_api_key

# Optional: Model-specific overrides used in grammar check
GRAMMAR_MODEL=gemini/gemini-2.0-flash-lite
